A data file directly in a package directory is an input of the package (a library may locate it at run time).
-- base/a/a.go --
package a

import (
	"example.com/m/b"
)

func A() { b.B() }
-- base/a/a_test.go --
package a

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/a/data.json --
{}
