a's in-package test imports c: changing c selects a's tests, but not d or e, which import a's library only.
-- base/a/a.go --
package a

import (
	"example.com/m/b"
)

func A() { b.B() }
-- base/a/a_test.go --
package a

import (
	"testing"
	"example.com/m/c"
)

func TestX(t *testing.T) { c.F() }
-- base/b/b.go --
package b

func B() {}
-- base/b/b_test.go --
package b

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/c/c.go --
package c

func F() {}
-- base/c/c_test.go --
package c

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/d/d.go --
package d

import (
	"example.com/m/a"
)

func D() { a.A() }
-- base/d/d_test.go --
package d

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/e/e.go --
package e

import (
	"example.com/m/a"
)

func E() { a.A() }
-- base/go.mod --
module example.com/m

go 1.22
-- head/c/c.go --
package c

func F() { _ = 1 }
-- want --
select go:c
select go:a
noselect go:d
noselect go:e
noselect go:b
