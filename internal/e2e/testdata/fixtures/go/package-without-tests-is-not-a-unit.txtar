A package without _test.go files is a dependency, not a unit; its importers are still selected.
-- base/a/a.go --
package a

import (
	"example.com/m/b"
)

func A() { b.B() }
-- base/a/a_test.go --
package a

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/b/b.go --
package b

func B() {}
-- base/b/b_test.go --
package b

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/c/c.go --
package c

import (
	"example.com/m/e"
)

func F() { e.E() }
-- base/c/c_test.go --
package c

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/d/d.go --
package d

import (
	"example.com/m/a"
)

func D() { a.A() }
-- base/d/d_test.go --
package d

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/e/e.go --
package e

func E() {}
-- base/go.mod --
module example.com/m

go 1.22
-- head/e/e.go --
package e

func E() { _ = 1 }
-- want --
select go:c
noselect go:e
noselect go:a
