A change in another module does not fire a's unresolved import.
-- base/m/a/a.go --
package a

import (
	"example.com/m/b"
	"example.com/m/gen/pb"
)

func A() { b.B(); pb.X() }
-- base/m/a/a_test.go --
package a

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/m/b/b.go --
package b

func B() {}
-- base/m/b/b_test.go --
package b

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/m/c/c.go --
package c

func F() {}
-- base/m/c/c_test.go --
package c

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/m/d/d.go --
package d

import (
	"example.com/m/a"
)

func D() { a.A() }
-- base/m/d/d_test.go --
package d

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/m/go.mod --
module example.com/m

go 1.22
-- base/m/schema/api.proto --
syntax = "proto3";
-- base/m/schema/schema.go --
package schema

func F() {}
-- base/tools/go.mod --
module example.com/tools

go 1.22
-- base/tools/t/t.go --
package t

func F() {}
-- base/tools/t/t_test.go --
package t

import (
	"testing"
)

func TestX(t *testing.T) {}
-- head/tools/t/t.go --
package t

func F() { _ = 1 }
-- want --
select go:tools/t
noselect go:m/a
nowiden unknown_import
