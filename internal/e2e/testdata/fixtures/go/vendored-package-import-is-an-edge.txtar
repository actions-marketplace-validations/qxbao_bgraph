An import of a vendored package resolves to vendor/: a precise edge besides the module widening.
-- base/m/a/a.go --
package a

import (
	"example.com/m/b"
	"github.com/ext/dep"
)

func A() { b.B(); dep.D() }
-- base/m/a/a_test.go --
package a

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/m/b/b.go --
package b

func B() {}
-- base/m/b/b_test.go --
package b

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/m/c/c.go --
package c

func F() {}
-- base/m/c/c_test.go --
package c

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/m/d/d.go --
package d

import (
	"example.com/m/a"
)

func D() { a.A() }
-- base/m/d/d_test.go --
package d

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/m/go.mod --
module example.com/m

go 1.22
-- base/m/vendor/github.com/ext/dep/dep.go --
package dep

func D() {}
-- base/tools/go.mod --
module example.com/tools

go 1.22
-- base/tools/t/t.go --
package t

func F() {}
-- base/tools/t/t_test.go --
package t

import (
	"testing"
)

func TestX(t *testing.T) {}
-- head/m/vendor/github.com/ext/dep/dep.go --
package dep

func D() { _ = 1 }
-- want --
precise go:m/a
precise go:m/d
widened go:m/c
noselect go:tools/t
