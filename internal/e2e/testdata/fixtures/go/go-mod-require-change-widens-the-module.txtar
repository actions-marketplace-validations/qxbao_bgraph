A require change widens the module with Eco go. A module nested in its directory is selected too: a widening scope cannot exclude a sub-directory (over-selection, sound).
-- base/a/a.go --
package a

import (
	"example.com/m/b"
)

func A() { b.B() }
-- base/a/a_test.go --
package a

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/b/b.go --
package b

func B() {}
-- base/b/b_test.go --
package b

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/c/c.go --
package c

func F() {}
-- base/c/c_test.go --
package c

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/d/d.go --
package d

import (
	"example.com/m/a"
)

func D() { a.A() }
-- base/d/d_test.go --
package d

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/go.mod --
module example.com/m

go 1.22

require golang.org/x/text v0.3.0
-- base/tools/go.mod --
module example.com/tools

go 1.22
-- base/tools/t/t.go --
package t

func F() {}
-- base/tools/t/t_test.go --
package t

import (
	"testing"
)

func TestX(t *testing.T) {}
-- head/go.mod --
module example.com/m

go 1.22

require golang.org/x/text v0.4.0
-- want --
select go:a
select go:c
select go:tools/t
widen manifest_changed
scope module
notfull
