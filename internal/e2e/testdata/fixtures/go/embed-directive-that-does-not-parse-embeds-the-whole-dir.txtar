An unparseable //go:embed directive is treated as embedding the whole package directory tree.
-- base/a/a.go --
package a

import (
	"embed"
	"example.com/m/b"
)

//go:embed "unterminated
var s string

func A() { b.B() }
-- base/a/a_test.go --
package a

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/a/web/sub/sub.go --
package sub

func F() {}
-- base/a/web/sub/x.txt --
x
-- base/b/b.go --
package b

func B() {}
-- base/b/b_test.go --
package b

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/c/c.go --
package c

func F() {}
-- base/c/c_test.go --
package c

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/d/d.go --
package d

import (
	"example.com/m/a"
)

func D() { a.A() }
-- base/d/d_test.go --
package d

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/go.mod --
module example.com/m

go 1.22
-- head/a/web/sub/x.txt --
y
-- want --
select go:a
noselect go:c
