A GOPATH-layout file elsewhere does not widen changes inside a module.
-- base/mod/a/a.go --
package a

func F() {}
-- base/mod/a/a_test.go --
package a

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/mod/go.mod --
module example.com/mod

go 1.22
-- base/src/github.com/x/y/y.go --
package y

func F() {}
-- head/mod/a/a.go --
package a

func F() { _ = 1 }
-- want --
select go:mod/a
notfull
nowiden unknown_file
