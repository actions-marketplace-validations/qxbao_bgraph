An external test package (a_test) imports c: changing c selects a; d imports only a's library and is not selected.
-- base/a/a.go --
package a

import (
	"example.com/m/b"
)

func A() { b.B() }
-- base/a/a_test.go --
package a

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/a/x_test.go --
package a_test

import (
	"testing"
	"example.com/m/a"
	"example.com/m/c"
)

func TestY(t *testing.T) { a.A(); c.F() }
-- base/b/b.go --
package b

func B() {}
-- base/b/b_test.go --
package b

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/c/c.go --
package c

func F() {}
-- base/c/c_test.go --
package c

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/d/d.go --
package d

import (
	"example.com/m/a"
)

func D() { a.A() }
-- base/d/d_test.go --
package d

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/go.mod --
module example.com/m

go 1.22
-- head/c/c.go --
package c

func F() { _ = 1 }
-- want --
select go:a
select go:c
noselect go:d
noselect go:b
