An embed in a _test.go file is a test input: a is selected, d (which imports a's library) is not.
-- base/a/a.go --
package a

import (
	"example.com/m/b"
)

func A() { b.B() }
-- base/a/a_test.go --
package a

import (
	"testing"
	"embed"
)

//go:embed gen/out.txt
var golden string
-- base/a/gen/gen.go --
package gen

func F() {}
-- base/a/gen/out.txt --
x
-- base/b/b.go --
package b

func B() {}
-- base/b/b_test.go --
package b

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/c/c.go --
package c

func F() {}
-- base/c/c_test.go --
package c

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/d/d.go --
package d

import (
	"example.com/m/a"
)

func D() { a.A() }
-- base/d/d_test.go --
package d

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/go.mod --
module example.com/m

go 1.22
-- head/a/gen/out.txt --
y
-- want --
select go:a
noselect go:d
noselect go:c
