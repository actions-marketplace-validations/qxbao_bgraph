A GOOS/GOARCH-suffixed file and a //go:build ignore generator both belong to the package: their imports are edges.
-- base/a/a.go --
package a

import (
	"example.com/m/b"
)

func A() { b.B() }
-- base/a/a_plan9_arm64.go --
package a

import (
	"example.com/m/c"
)

func W() { c.F() }
-- base/a/a_test.go --
package a

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/a/gen.go --
//go:build ignore

package main

import (
	"example.com/m/b"
)

func main() { b.B() }
-- base/b/b.go --
package b

func B() {}
-- base/b/b_test.go --
package b

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/c/c.go --
package c

func F() {}
-- base/c/c_test.go --
package c

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/d/d.go --
package d

import (
	"example.com/m/a"
)

func D() { a.A() }
-- base/d/d_test.go --
package d

import (
	"testing"
)

func TestX(t *testing.T) {}
-- base/go.mod --
module example.com/m

go 1.22
-- head/c/c.go --
package c

func F() { _ = 1 }
-- want --
select go:a
select go:c
noselect go:b
