A Composer test script can point at a different suite from the default XML.
-- base/app/composer.json --
{"require-dev":{"phpunit/phpunit":"^11"},"scripts":{"test":"@php vendor/bin/phpunit --configuration=phpunit.ci.xml"}}
-- base/app/phpunit.xml --
<phpunit><testsuites><testsuite name="unit"><directory>tests</directory></testsuite></testsuites></phpunit>
-- base/app/phpunit.ci.xml --
<phpunit><testsuites><testsuite name="ci"><file>checks/Check.php</file></testsuite></testsuites></phpunit>
-- base/app/tests/SmokeTest.php --
<?php
-- base/app/checks/Check.php --
<?php
-- base/other/composer.json --
{"require-dev":{"phpunit/phpunit":"^11"}}
-- base/other/tests/OtherTest.php --
<?php
-- head/app/checks/Check.php --
<?php // changed
-- want --
widened app::php
noselect other::php
