An unsupported stream wrapper can read a sibling project's input.
-- base/app/composer.json --
{"require-dev":{"phpunit/phpunit":"^11"}}
-- base/app/tests/AppTest.php --
<?php file_get_contents('php://filter/read=convert.base64-encode/resource=../data/input.txt');
-- base/data/composer.json --
{"name":"fixture/data"}
-- base/data/input.txt --
before
-- base/other/composer.json --
{"require-dev":{"phpunit/phpunit":"^11"}}
-- base/other/tests/OtherTest.php --
<?php
-- head/data/input.txt --
after
-- want --
select app::php
noselect other::php
widen unknown_import
notfull
