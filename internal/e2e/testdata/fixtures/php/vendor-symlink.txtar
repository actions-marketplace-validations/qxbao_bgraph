A Composer vendor symlink links its PHP consumer to a repo file outside every PHP project.
-- base/app/composer.json --
{"require-dev":{"phpunit/phpunit":"^10"}}
-- base/app/tests/AppTest.php --
<?php
-- base/independent/composer.json --
{"require-dev":{"phpunit/phpunit":"^10"}}
-- base/independent/tests/OtherTest.php --
<?php
-- base/shared/Library.php --
<?php function x() { return 1; }
-- link:base/app/vendor/library --
../../shared
-- base/web/package.json --
{"devDependencies":{"vitest":"1.0.0"}}
-- base/web/check.test.ts --
export {}
-- head/shared/Library.php --
<?php function x() { return 2; }
-- want --
select app::php
noselect independent::php
noselect web/check.test.ts
notfull
