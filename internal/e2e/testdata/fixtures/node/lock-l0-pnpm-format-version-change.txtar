pnpm lockfile version 6.0 -> 9.0 (resolution format changed) -> level L0 even though the packages are the same.
-- base/package.json --
{"name":"root","private":true,"devDependencies":{"vitest":"^1.0.0"}}
-- base/pnpm-workspace.yaml --
packages:
  - "packages/*"
-- base/packages/a/package.json --
{"name":"a","dependencies":{"b":"workspace:*","lodash":"^4.0.0"}}
-- base/packages/a/src/a.ts --
import _ from 'lodash'
export const a = _.identity(1)
-- base/packages/a/test/a.test.ts --
import { a } from '../src/a'
void a
-- base/packages/a/test/plain.test.ts --
export {}
-- base/packages/b/package.json --
{"name":"b","dependencies":{"ms":"^2.0.0"}}
-- base/packages/b/src/b.ts --
import ms from 'ms'
export const b = ms('1s')
-- base/packages/b/test/b.test.ts --
import { b } from '../src/b'
void b
-- base/packages/c/package.json --
{"name":"c","dependencies":{"left-pad":"^1.0.0"}}
-- base/packages/c/test/c.test.ts --
import { b } from '../../b/src/b'
void b
-- base/packages/d/package.json --
{"name":"d","dependencies":{"left-pad":"^1.0.0"}}
-- base/packages/d/src/d.ts --
import leftPad from 'left-pad'
export const d = leftPad('x', 2)
-- base/packages/d/test/d.test.ts --
import { d } from '../src/d'
void d
-- base/packages/d/test/other.test.ts --
export {}
-- base/pnpm-lock.yaml --
lockfileVersion: '6.0'

settings:
  autoInstallPeers: true
  excludeLinksFromLockfile: false

importers:

  .:
    devDependencies:
      vitest:
        specifier: ^1.0.0
        version: 1.0.0

  packages/a:
    dependencies:
      b:
        specifier: workspace:*
        version: link:../b
      lodash:
        specifier: ^4.0.0
        version: 4.17.21

  packages/b:
    dependencies:
      ms:
        specifier: ^2.0.0
        version: 2.1.3

  packages/c:
    dependencies:
      left-pad:
        specifier: ^1.0.0
        version: 1.3.0

  packages/d:
    dependencies:
      left-pad:
        specifier: ^1.0.0
        version: 1.3.0

packages:

  left-pad@1.3.0:
    resolution: {integrity: sha512-leftpad}

  lodash@4.17.21:
    resolution: {integrity: sha512-lodash4.17.21}

  ms@2.1.3:
    resolution: {integrity: sha512-ms2.1.3}

  vitest@1.0.0:
    resolution: {integrity: sha512-vitest1.0.0}
    hasBin: true

  x-util@1.0.0:
    resolution: {integrity: sha512-xutil1.0.0}

snapshots:

  left-pad@1.3.0:
    dependencies:
      x-util: 1.0.0

  lodash@4.17.21: {}

  ms@2.1.3: {}

  vitest@1.0.0: {}

  x-util@1.0.0: {}
