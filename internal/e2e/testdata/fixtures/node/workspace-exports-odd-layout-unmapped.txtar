Đầu ra build/ (không có trong cây), nguồn ở source/ lạ, không có tsconfig/luật: đổi nguồn phải chọn test của b qua nới unknown_import.
-- base/package.json --
{"name":"root","private":true,"workspaces":["packages/*"]}
-- base/packages/a/package.json --
{"name":"@org/a","exports":{".":"./build/index.js"}}
-- base/packages/a/source/index.ts --
export const a = 1
-- base/packages/b/package.json --
{"name":"@org/b","dependencies":{"@org/a":"*"}}
-- base/packages/b/b.test.ts --
import { a } from '@org/a'
-- base/packages/c/package.json --
{"name":"@org/c"}
-- base/packages/c/c.test.ts --
export {}
-- head/packages/a/source/index.ts --
export const a = 2
-- want --
select packages/b/b.test.ts
noselect packages/c/c.test.ts
widen unknown_import
notfull
