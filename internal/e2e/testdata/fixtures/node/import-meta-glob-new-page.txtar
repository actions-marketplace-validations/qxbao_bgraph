import.meta.glob('./pages/*.ts'): adding a new page selects the test of the file that uses the glob.
-- base/package.json --
{"name":"app","devDependencies":{"vitest":"^5.0.0"}}
-- base/src/routes.ts --
export const pages = import.meta.glob('./pages/*.ts')
-- base/src/pages/home.ts --
export default 1
-- base/src/a.test.ts --
import { pages } from './routes'
-- base/src/b.test.ts --
export {}
-- head/src/pages/about.ts --
export default 2
-- want --
select src/a.test.ts
noselect src/b.test.ts
