L2 with an npm alias (import name my-lodash, package lodash): the dependency key is the import name, so the bump
narrows to the importers of my-lodash.
-- base/package.json --
{"name":"app","dependencies":{"my-lodash":"npm:lodash@^4.0.0","ms":"^2.0.0"},"devDependencies":{"jest":"^29.0.0"}}
-- base/src/a.js --
module.exports = require('my-lodash').identity(1)
-- base/src/b.js --
module.exports = require('ms')('1s')
-- base/test/a.test.js --
require('../src/a')
-- base/test/b.test.js --
require('../src/b')
-- base/bgraph.toml --
[lockfile]
level = "L2"
