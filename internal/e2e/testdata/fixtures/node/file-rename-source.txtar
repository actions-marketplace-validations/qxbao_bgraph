Renaming a source file (delete + add) together with fixing the importer: the importer's test is selected.
-- base/package.json --
{"name":"app","devDependencies":{"vitest":"^5.0.0"}}
-- base/src/old.ts --
export const v = 1
-- base/src/a.test.ts --
import { v } from './old'
-- base/src/b.test.ts --
export {}
-- delete/src/old.ts --
-- head/src/new.ts --
export const v = 1
-- head/src/a.test.ts --
import { v } from './new'
-- want --
select src/a.test.ts
noselect src/b.test.ts
