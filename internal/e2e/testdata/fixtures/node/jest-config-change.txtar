Changing jest.config.js widens test_config_changed and selects every test of the project.
-- base/package.json --
{"name":"app","devDependencies":{"jest":"^30.0.0"}}
-- base/jest.config.js --
module.exports = { testTimeout: 1000 }
-- base/src/a.test.js --
module.exports = 0
-- head/jest.config.js --
module.exports = { testTimeout: 5000 }
-- want --
widen test_config_changed
select src/a.test.js
