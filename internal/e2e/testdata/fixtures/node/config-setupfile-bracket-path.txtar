setupFiles trỏ tới tệp có "[" trong tên (kiểu Next.js): cạnh chính xác, không bị hiểu thành glob. Đổi tệp đó chọn mọi test của dự án.
-- base/package.json --
{"name":"app","devDependencies":{"jest":"^30.0.0"}}
-- base/jest.config.js --
module.exports = { setupFiles: ['<rootDir>/setup/[env].js'] }
-- base/setup/[env].js --
global.x = 1
-- base/src/a.test.js --
test('a', () => {})
-- head/setup/[env].js --
global.x = 2
-- want --
select src/a.test.js
nowiden unreferenced_file
