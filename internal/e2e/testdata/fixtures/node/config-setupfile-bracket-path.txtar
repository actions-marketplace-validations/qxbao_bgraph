setupFiles points to a file with "[" in its name (Next.js style): an exact edge, not interpreted as a glob. Changing that file selects every test of the project.
-- base/package.json --
{"name":"app","devDependencies":{"jest":"^30.0.0"}}
-- base/jest.config.js --
module.exports = { setupFiles: ['<rootDir>/setup/[env].js'] }
-- base/setup/[env].js --
global.x = 1
-- base/src/a.test.js --
test('a', () => {})
-- head/setup/[env].js --
global.x = 2
-- want --
select src/a.test.js
nowiden unreferenced_file
