Zod style: exports with a source condition ("@zod/source" → src), build-output edges at the package root (absent from the tree). Changing a test file in the package does not select every importer of the package; changing the source entry does.
-- base/package.json --
{"name":"root","private":true,"devDependencies":{"vitest":"^5.0.0"}}
-- base/packages/zod/package.json --
{"name":"zod","exports":{"./v4":{"@zod/source":"./src/v4/index.ts","types":"./v4/index.d.cts","import":"./v4/index.js","require":"./v4/index.cjs"}}}
-- base/packages/zod/src/v4/index.ts --
export const z = 1
-- base/packages/zod/src/v4/tests/validate.test.ts --
import { z } from '../index'
-- base/packages/app/package.json --
{"name":"app","dependencies":{"zod":"workspace:*"}}
-- base/packages/app/src/use.test.ts --
import { z } from 'zod/v4'
-- head/packages/zod/src/v4/tests/validate.test.ts --
import { z } from '../index'
// changed
-- want --
select packages/zod/src/v4/tests/validate.test.ts
noselect packages/app/src/use.test.ts
