An undeclared bare package import ('ghost-package'): tracked via the glob **/ghost-package{,.*,/**}. Changing vendor/ghost-package/index.js → selects the test that imports it; changing another file → does not.
-- base/package.json --
{"name":"app","devDependencies":{"vitest":"^5.0.0"}}
-- base/src/a.test.ts --
import x from 'ghost-package'
-- base/src/b.test.ts --
import { o } from './other'
-- base/src/other.ts --
export const o = 1
-- base/vendor/ghost-package/index.js --
module.exports = 1
-- head/vendor/ghost-package/index.js --
module.exports = 2
-- want --
select src/a.test.ts
noselect src/b.test.ts
