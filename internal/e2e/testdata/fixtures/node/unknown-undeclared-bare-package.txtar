Import gói trần không khai báo ('ghost-package'): theo dõi qua glob **/ghost-package{,.*,/**}. Tệp vendor/ghost-package/index.js đổi → chọn test import nó; tệp khác đổi → không chọn.
-- base/package.json --
{"name":"app","devDependencies":{"vitest":"^5.0.0"}}
-- base/src/a.test.ts --
import x from 'ghost-package'
-- base/src/b.test.ts --
import { o } from './other'
-- base/src/other.ts --
export const o = 1
-- base/vendor/ghost-package/index.js --
module.exports = 1
-- head/vendor/ghost-package/index.js --
module.exports = 2
-- want --
select src/a.test.ts
noselect src/b.test.ts
