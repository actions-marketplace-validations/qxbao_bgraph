Preact style: the test imports 'preact' (self-reference); exports points to dist/ (absent from the tree) while types points to src/index.d.ts (present). Changing src/render.js must select the test, even though the resolver finds one target (.d.ts).
-- base/package.json --
{"name":"preact","main":"dist/preact.js","types":"src/index.d.ts","exports":{".":{"types":"./src/index.d.ts","import":"./dist/preact.mjs","require":"./dist/preact.js"}},"devDependencies":{"mocha":"^10.0.0"}}
-- base/src/index.d.ts --
export function render(): void
-- base/src/index.js --
export { render } from './render'
-- base/src/render.js --
export function render() {}
-- base/test/browser/render.test.js --
import { render } from 'preact'
-- head/src/render.js --
export function render() { return 1 }
-- want --
select test/browser/render.test.js
