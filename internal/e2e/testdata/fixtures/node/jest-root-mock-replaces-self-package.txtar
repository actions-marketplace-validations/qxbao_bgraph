Dayjs style: locale imports 'dayjs' (main → dayjs.min.js, a build output absent from the tree); jest roots ['test'] and test/__mocks__/dayjs.js requires '../../src'. The edge through the mock is exact: changing an unrelated plugin does not select the locale tests; changing src/index.js does.
-- base/package.json --
{"name":"dayjs","main":"dayjs.min.js","devDependencies":{"jest":"^22.0.0"},"jest":{"roots":["test"],"testRegex":"test/(.*?/)?.*test.js$"}}
-- base/src/index.js --
export default function dayjs() {}
-- base/src/locale/zh.js --
import dayjs from 'dayjs'
export default { name: 'zh', d: dayjs }
-- base/src/plugin/weekYear/index.js --
export default () => {}
-- base/test/__mocks__/dayjs.js --
const dayjs = require('../../src')
module.exports = dayjs
-- base/test/locale/zh.test.js --
import zh from '../../src/locale/zh'
-- base/test/plugin/weekYear.test.js --
import p from '../../src/plugin/weekYear'
-- head/src/plugin/weekYear/index.js --
export default () => { return 1 }
-- want --
select test/plugin/weekYear.test.js
noselect test/locale/zh.test.js
