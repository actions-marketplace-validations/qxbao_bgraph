An undeclared bare import ("shared/util") may point into the repo via NODE_PATH/moduleDirectories: changing lib/shared/util.js must select the test; changing another file must not select it.
-- base/package.json --
{"name":"app","devDependencies":{"jest":"^30.0.0"}}
-- base/src/a.js --
module.exports = require('shared/util')
-- base/src/a.test.js --
require('./a')
-- base/src/b.test.js --
require('./b')
-- base/src/b.js --
module.exports = 1
-- base/lib/shared/util.js --
module.exports = 1
-- head/lib/shared/util.js --
module.exports = 2
-- want --
select src/a.test.js
noselect src/b.test.js
