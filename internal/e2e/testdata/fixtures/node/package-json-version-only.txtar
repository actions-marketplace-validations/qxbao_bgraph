Changing only "version" in package.json: harmless, no widening, selects nothing.
-- base/package.json --
{"name":"app","version":"1.0.0","devDependencies":{"vitest":"^5.0.0"}}
-- base/src/a.test.ts --
export {}
-- head/package.json --
{"name":"app","version":"1.0.1","devDependencies":{"vitest":"^5.0.0"}}
-- want --
nowiden manifest_changed
notfull
noselect src/a.test.ts
scope none
