ESM TypeScript writes import './util.js' but the real file is util.ts (extension substitution).
-- base/package.json --
{"name":"app","type":"module","devDependencies":{"vitest":"^5.0.0"}}
-- base/src/util.ts --
export const a = 1
-- base/src/a.test.ts --
import { a } from './util.js'
-- base/src/b.test.ts --
export {}
-- head/src/util.ts --
export const a = 2
-- want --
select src/a.test.ts
noselect src/b.test.ts
