A relative import to a file that does not exist yet; a change that ADDS that file must select the test (negative dependency).
-- base/package.json --
{"name":"app","devDependencies":{"vitest":"^5.0.0"}}
-- base/src/a.test.ts --
import { g } from './gen'
-- base/src/b.test.ts --
export {}
-- head/src/gen.ts --
export const g = 1
-- want --
select src/a.test.ts
