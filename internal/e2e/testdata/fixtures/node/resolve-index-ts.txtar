Importing a directory resolves to index.ts.
-- base/package.json --
{"name":"app","devDependencies":{"vitest":"^5.0.0"}}
-- base/src/lib/index.ts --
export const a = 1
-- base/src/a.test.ts --
import { a } from './lib'
-- base/src/b.test.ts --
export {}
-- head/src/lib/index.ts --
export const a = 2
-- want --
select src/a.test.ts
noselect src/b.test.ts
