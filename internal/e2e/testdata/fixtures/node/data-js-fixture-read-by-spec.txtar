Prettier style: tests/format/foo/*.js are data that jsfmt.spec.js reads as a whole directory via import.meta (no import). Changing a data file must select the spec (through an unreferenced_file widening), never silently select nothing.
-- base/package.json --
{"name":"app","devDependencies":{"jest":"^30.0.0"}}
-- base/tests/format/foo/jsfmt.spec.js --
runFormatTest(import.meta, ["babel"])
-- base/tests/format/foo/arrow.js --
const a = (x) => x
-- base/src/index.js --
module.exports = 1
-- head/tests/format/foo/arrow.js --
const a = x => x
-- want --
select tests/format/foo/jsfmt.spec.js
widen unreferenced_file
