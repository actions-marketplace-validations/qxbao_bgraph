Renaming a source file while the importer is NOT fixed (broken import): the importer's test must still be selected.
-- base/package.json --
{"name":"app","devDependencies":{"vitest":"^5.0.0"}}
-- base/src/old.ts --
export const v = 1
-- base/src/a.test.ts --
import { v } from './old'
-- base/src/b.test.ts --
export {}
-- delete/src/old.ts --
-- head/src/new.ts --
export const v = 1
-- want --
select src/a.test.ts
# nobody imports new.ts: widens to the project (a test may read it outside the graph)
widen unreferenced_file
