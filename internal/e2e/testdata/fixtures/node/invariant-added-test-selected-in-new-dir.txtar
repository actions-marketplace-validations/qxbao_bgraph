RTSCheck: adding a test in a new directory (imported by nobody) selects that test and not the old ones.
-- base/package.json --
{"name":"app","devDependencies":{"vitest":"^5.0.0"}}
-- base/src/a.test.ts --
export {}
-- head/tests/brand-new.test.ts --
test('x', () => {})
-- want --
select tests/brand-new.test.ts
noselect src/a.test.ts
