affects="none" on a file that is a graph node (an imported json): rejected, rule_rejected warning, the test is still selected.
-- base/package.json --
{"name":"app","devDependencies":{"vitest":"^5.0.0"}}
-- base/bgraph.toml --
[[rule]]
paths = ["src/data.json"]
affects = "none"
-- base/src/data.json --
{"a":1}
-- base/src/a.test.ts --
import d from './data.json'
-- base/src/b.test.ts --
export {}
-- head/src/data.json --
{"a":2}
-- want --
warn rule_rejected
select src/a.test.ts
noselect src/b.test.ts
