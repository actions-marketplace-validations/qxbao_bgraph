A CJS require() with a relative path creates an edge.
-- base/package.json --
{"name":"app","devDependencies":{"jest":"^30.0.0"}}
-- base/src/lib.js --
module.exports = 1
-- base/src/a.test.js --
const lib = require('./lib')
-- base/src/b.test.js --
module.exports = 0
-- head/src/lib.js --
module.exports = 2
-- want --
select src/a.test.js
noselect src/b.test.js
