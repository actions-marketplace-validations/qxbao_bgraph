require(variable) has no static prefix: any change in the repo selects the tests that touch that file.
-- base/package.json --
{"name":"app","devDependencies":{"jest":"^30.0.0"}}
-- base/src/loader.js --
module.exports = (n) => require(n)
-- base/src/a.test.js --
const l = require('./loader')
-- base/src/b.test.js --
module.exports = 0
-- base/src/unrelated.js --
module.exports = 1
-- base/src/c.js --
module.exports = require('./unrelated')
-- head/src/unrelated.js --
module.exports = 2
-- want --
select src/a.test.js
noselect src/b.test.js
widen dynamic_import
