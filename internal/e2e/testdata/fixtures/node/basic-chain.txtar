Three-level import chain: changing the leaf file selects the test that goes through it, and does not select unrelated tests.
-- base/package.json --
{"name":"app","devDependencies":{"vitest":"^5.0.0"}}
-- base/src/util.ts --
export const add = (a: number, b: number) => a + b
-- base/src/math.ts --
import { add } from './util'
export const sum = (xs: number[]) => xs.reduce(add, 0)
-- base/src/math.test.ts --
import { sum } from './math'
import { test, expect } from 'vitest'
test('sum', () => expect(sum([1, 2])).toBe(3))
-- base/src/other.test.ts --
import { test } from 'vitest'
test('x', () => {})
-- head/src/util.ts --
export const add = (a: number, b: number) => b + a
-- want --
select src/math.test.ts
noselect src/other.test.ts
scope graph
