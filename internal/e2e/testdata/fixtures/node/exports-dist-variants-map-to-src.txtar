Hono style: exports has dist/index.js, dist/cjs/index.js, dist/types/index.d.ts (absent from the tree); every variant maps back to src/index.ts → an exact edge, no widening to the whole repo; changing an unrelated file selects no test.
-- base/package.json --
{"name":"hono","exports":{".":{"types":"./dist/types/index.d.ts","import":"./dist/index.js","require":"./dist/cjs/index.js"}},"devDependencies":{"vitest":"^5.0.0"}}
-- base/src/index.ts --
export const app = 1
-- base/src/other.ts --
export const o = 1
-- base/src/other.test.ts --
import { o } from './other'
-- base/adapters/x/handler.test.ts --
import { app } from 'hono'
-- head/src/index.ts --
export const app = 2
-- want --
select adapters/x/handler.test.ts
noselect src/other.test.ts
nowiden unknown_import
