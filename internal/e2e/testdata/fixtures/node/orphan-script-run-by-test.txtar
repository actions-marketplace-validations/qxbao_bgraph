bin/cli.js is imported by nobody; a test runs it via child_process with a concatenated path. Changing bin/cli.js must select that test.
-- base/package.json --
{"name":"app","bin":{"app":"bin/cli.js"},"devDependencies":{"vitest":"^5.0.0"}}
-- base/bin/cli.js --
console.log('hi')
-- base/test/cli.test.js --
import { execFileSync } from 'node:child_process'
import { join } from 'node:path'
execFileSync('node', [join(__dirname, '..', 'bin', 'cli' + '.js')])
-- head/bin/cli.js --
console.log('hello')
-- want --
select test/cli.test.js
widen unreferenced_file
