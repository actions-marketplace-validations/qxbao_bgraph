Đổi dependencies trong package.json: nới manifest_changed tới dự án.
-- base/package.json --
{"name":"app","devDependencies":{"vitest":"^5.0.0"},"dependencies":{"lodash":"4.17.20"}}
-- base/src/a.test.ts --
export {}
-- head/package.json --
{"name":"app","devDependencies":{"vitest":"^5.0.0"},"dependencies":{"lodash":"4.17.21"}}
-- want --
widen manifest_changed
select src/a.test.ts
