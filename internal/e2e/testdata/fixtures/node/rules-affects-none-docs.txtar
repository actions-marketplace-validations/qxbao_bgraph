affects="none" cho docs/**: tệp lạ trong docs không nới.
-- base/package.json --
{"name":"app","devDependencies":{"vitest":"^5.0.0"}}
-- base/bgraph.toml --
[[rule]]
paths = ["docs/**"]
affects = "none"
