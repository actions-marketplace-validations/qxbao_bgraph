Changing the project's tsconfig.json widens test_config_changed and selects that project's tests.
-- base/package.json --
{"name":"app","devDependencies":{"vitest":"^5.0.0"}}
-- base/tsconfig.json --
{"compilerOptions":{"strict":false}}
-- base/src/a.test.ts --
export {}
-- head/tsconfig.json --
{"compilerOptions":{"strict":true}}
-- want --
widen test_config_changed
select src/a.test.ts
