L2 with a Jest root mock of an external package: the test resolves lodash to __mocks__/lodash.js, which loads the real
package (jest.requireActual); a lodash bump still selects it (tools/c.js, in a nested package without Jest mocks, makes lodash count as imported, so L2 applies).
-- base/package.json --
{"name":"app","dependencies":{"lodash":"^4.0.0","ms":"^2.0.0"},"devDependencies":{"jest":"^29.0.0"}}
-- base/__mocks__/lodash.js --
const actual = jest.requireActual('lodash')
module.exports = { ...actual }
-- base/tools/package.json --
{"name":"tools","private":true,"dependencies":{"lodash":"^4.0.0"}}
-- base/tools/c.js --
module.exports = require('lodash').identity
-- base/test/a.test.js --
const _ = require('lodash')
_.identity(1)
-- base/test/b.test.js --
require('ms')('1s')
-- base/bgraph.toml --
[lockfile]
level = "L2"
