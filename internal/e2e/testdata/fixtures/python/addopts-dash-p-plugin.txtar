`-p name` in addopts loads a module for every test of the project.
-- base/pytest.ini --
[pytest]
addopts = -p myplug -ra
-- base/myplug.py --
X = 1
-- base/tests/test_a.py --
import json
-- base/tests/test_b.py --
import json
-- head/myplug.py --
X = 2
-- want --
notfull
select tests/test_a.py
select tests/test_b.py
