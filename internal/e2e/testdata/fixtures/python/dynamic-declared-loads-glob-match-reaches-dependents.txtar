A change matching the declared glob reaches the declaring file and its dependents.
-- base/pyproject.toml --
[project]
name = "x"
version = "1"
-- base/pkg/__init__.py --
-- base/pkg/loader.py --
import importlib
def load(n):
    return importlib.import_module(n)
-- base/pkg/unrelated.py --
X = 1
-- base/tests/test_loader.py --
from pkg.loader import load
-- base/tests/test_unrelated.py --
import pkg.unrelated
-- base/docs/notes.md --
a
-- base/.flake8 --
[flake8]
-- base/plugins/p1.py --
X = 1
-- base/bgraph.toml --
[[dynamic]]
file = "pkg/loader.py"
loads = ["plugins/**/*.py"]
reason = "load() only imports the plugins/ modules"
-- head/plugins/p1.py --
X = 2
-- want --
notfull
select tests/test_loader.py
noselect tests/test_unrelated.py
