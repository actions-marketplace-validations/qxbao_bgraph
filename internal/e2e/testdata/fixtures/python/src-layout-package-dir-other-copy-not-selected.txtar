The same package name under a directory that is not an import root does not select the test.
-- base/pyproject.toml --
[project]
name = "x"
version = "1"
[tool.setuptools.packages.find]
where = ["code"]
-- base/code/mypkg/__init__.py --
-- base/code/mypkg/core.py --
X = 1
-- base/legacy/mypkg/__init__.py --
-- base/legacy/mypkg/core.py --
X = 0
-- base/tests/test_core.py --
from mypkg.core import X
-- base/tests/test_legacy.py --
import legacy.mypkg.core
-- head/legacy/mypkg/core.py --
X = 5
-- want --
notfull
select tests/test_legacy.py
noselect tests/test_core.py
