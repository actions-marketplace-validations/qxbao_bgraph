A change in a module reached only through a relative import selects just that importer's tests.
-- base/pyproject.toml --
[project]
name = "x"
version = "1"
-- base/pkg/__init__.py --
-- base/pkg/a.py --
from .b import V
-- base/pkg/b.py --
V = 1
-- base/pkg/c.py --
V = 1
-- base/tests/test_a.py --
import pkg.a
-- base/tests/test_c.py --
import pkg.c
-- head/pkg/b.py --
V = 2
-- want --
notfull
select tests/test_a.py
noselect tests/test_c.py
