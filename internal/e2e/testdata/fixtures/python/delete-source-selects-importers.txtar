Deleting a module selects its importers.
-- base/pyproject.toml --
[project]
name = "x"
version = "1"
-- base/pkg/__init__.py --
-- base/pkg/gone.py --
X = 1
-- base/tests/test_a.py --
from pkg.gone import X
-- base/tests/test_b.py --
import json
-- delete/pkg/gone.py --
-- want --
notfull
select tests/test_a.py
noselect tests/test_b.py
