SwiftPM lockfile widening stays in the exact package and Swift ecosystem.
-- base/Package.swift --
// swift-tools-version: 5.9
import PackageDescription
let package = Package(name: "Root", targets: [.target(name: "Core"), .target(name: "Other"), .testTarget(name: "CoreSuite", dependencies: ["Core"]), .testTarget(name: "OtherSuite", dependencies: ["Other"])])
-- base/Sources/Core/Logic.swift --
public func value() -> Int { 1 }
-- base/Sources/Other/Other.swift --
public func other() -> Int { 1 }
-- base/Tests/CoreSuite/Tests.swift --
import XCTest
-- base/Tests/OtherSuite/Tests.swift --
import XCTest
-- base/Tools/Package.swift --
// swift-tools-version: 5.9
import PackageDescription
let package = Package(name: "Tools", targets: [.testTarget(name: "Suite")])
-- base/Tools/Tests/Suite/Test.swift --
import XCTest
-- base/web/package.json --
{"name":"web","devDependencies":{"vitest":"^2.0.0"}}
-- base/web/src/check.test.ts --
import { value } from './value'
void value
-- base/web/src/value.ts --
export const value = 1
-- base/Package.resolved --
{"version":2}
-- head/Package.resolved --
{"version":3}
-- want --
select swift:.::test:CoreSuite
select swift:.::test:OtherSuite
noselect swift:Tools::test:Suite
noselect web/src/check.test.ts
widen lock_changed
scope module
