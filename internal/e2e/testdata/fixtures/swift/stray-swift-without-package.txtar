{"name":"web","devDependencies":{"vitest":"^2.0.0"}}
-- base/src/check.test.ts --
import { value } from './value'
void value
-- base/src/value.ts --
export const value = 1
-- base/tools/helper.swift --
func one() {}
-- head/tools/helper.swift --
