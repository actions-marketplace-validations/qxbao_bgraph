// swift-tools-version: 5.9
import PackageDescription
let package = Package(name: "Root", defaultLocalization: "en", targets: [
    .target(name: "Library", sources: ["BundleText.swift"]),
    .testTarget(name: "LibraryTests", dependencies: ["Library"]),
])
