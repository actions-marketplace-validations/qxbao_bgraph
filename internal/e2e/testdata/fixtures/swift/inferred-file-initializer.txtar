// swift-tools-version: 5.9
import PackageDescription
let package = Package(name: "Root", targets: [.testTarget(name: "CoreSuite"), .testTarget(name: "OtherSuite")])
-- base/Tests/CoreSuite/Tests.swift --
import Foundation
import XCTest
final class ReaderTests: XCTestCase {
    func testData() throws {
        let url = URL(string: ProcessInfo.processInfo.environment["FIXTURE_URL"]!)!
        let data: Data = try .init(contentsOf: url)
        XCTAssertFalse(data.isEmpty)
    }
}
