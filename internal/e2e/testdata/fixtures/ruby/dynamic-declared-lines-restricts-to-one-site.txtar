lines = [3] covers only the require at line 3: the load at line 6 still fires.
-- base/Gemfile --
source "https://rubygems.org"
gemspec
-- base/foo.gemspec --
Gem::Specification.new { |s| s.name = "foo" }
-- base/lib/foo/plugins.rb --
module Foo
  def self.load_plugin(name)
    require name
  end
  def self.load_other(path)
    load path
  end
end
-- base/lib/foo/plain.rb --
P = 1
-- base/plugins/a.rb --
A = 1
-- base/spec/plugins_spec.rb --
require "foo/plugins"
-- base/spec/plain_spec.rb --
require "foo/plain"
-- base/bgraph.toml --
[[dynamic]]
file = "lib/foo/plugins.rb"
lines = [3]
none = true
reason = "only external gems at line 3"
-- head/lib/foo/plain.rb --
P = 2
-- want --
notfull
widen dynamic_import
select spec/plugins_spec.rb
select spec/plain_spec.rb
