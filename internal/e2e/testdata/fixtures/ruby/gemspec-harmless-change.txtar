A gemspec change limited to descriptive metadata selects nothing.
-- base/Gemfile --
source "https://rubygems.org"
gemspec
-- base/foo.gemspec --
Gem::Specification.new do |s|
  s.name = "foo"
  s.version = "1.0"
  s.summary = "Foo"
  s.files = Dir["lib/**/*.rb"]
  s.add_development_dependency "rspec"
end
-- base/spec/a_spec.rb --
x = 1
-- head/foo.gemspec --
Gem::Specification.new do |s|
  s.name = "foo"
  s.version = "1.0"
  s.summary = "Foo, the better one"
  s.metadata["changelog_uri"] = "https://example.com/changelog"
  s.files = Dir["lib/**/*.rb"]
  s.add_development_dependency "rspec"
end
-- want --
notfull
scope none
noselect spec/a_spec.rb
