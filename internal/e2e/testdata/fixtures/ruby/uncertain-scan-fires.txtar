A file the lexer cannot read reliably (unterminated heredoc) is uncertain: a Ruby change anywhere selects its dependents.
-- base/Gemfile --
source "https://rubygems.org"
gemspec
-- base/foo.gemspec --
Gem::Specification.new do |s|
  s.name = "foo"
  s.version = "1.0"
  s.summary = "Foo"
  s.files = Dir["lib/**/*.rb"]
  s.add_development_dependency "rspec"
end
-- base/lib/foo/broken.rb --
X = <<~EOS
  never terminated
-- base/lib/foo/leaf.rb --
L = 1
-- base/lib/foo/plain.rb --
P = 1
-- base/spec/broken_spec.rb --
require "foo/broken"
-- base/spec/leaf_spec.rb --
require "foo/leaf"
-- base/spec/plain_spec.rb --
require "foo/plain"
-- head/lib/foo/leaf.rb --
L = 2
-- want --
notfull
scope graph
nowiden unreferenced_file
select spec/leaf_spec.rb
widen uncertain_scan
select spec/broken_spec.rb
noselect spec/plain_spec.rb
