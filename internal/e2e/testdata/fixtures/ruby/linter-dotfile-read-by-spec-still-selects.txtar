A harmless dotfile that a spec names is still walked: the spec reading it is selected.
-- base/Gemfile --
source "https://rubygems.org"
gemspec
-- base/foo.gemspec --
Gem::Specification.new do |s|
  s.name = "foo"
  s.version = "1.0"
  s.summary = "Foo"
  s.files = Dir["lib/**/*.rb"]
  s.add_development_dependency "rspec"
end
-- base/.rubocop.yml --
AllCops:
  NewCops: enable
-- base/spec/config_spec.rb --
CFG = YAML.load_file(".rubocop.yml")
-- base/spec/a_spec.rb --
x = 1
-- head/.rubocop.yml --
AllCops:
  NewCops: disable
-- want --
notfull
select spec/config_spec.rb
noselect spec/a_spec.rb
