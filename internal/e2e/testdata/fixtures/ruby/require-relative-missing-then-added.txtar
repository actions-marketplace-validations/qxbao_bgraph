A require_relative of a file that is not in the base tree keeps an exact edge: adding the file selects the importer.
-- base/Gemfile --
source "https://rubygems.org"
gemspec
-- base/foo.gemspec --
Gem::Specification.new do |s|
  s.name = "foo"
  s.version = "1.0"
  s.summary = "Foo"
  s.files = Dir["lib/**/*.rb"]
  s.add_development_dependency "rspec"
end
-- base/lib/foo/a.rb --
require_relative "generated"
-- base/spec/a_spec.rb --
require_relative "../lib/foo/a"
-- base/spec/b_spec.rb --
x = 1
-- head/lib/foo/generated.rb --
G = 1
-- want --
notfull
select spec/a_spec.rb
noselect spec/b_spec.rb
