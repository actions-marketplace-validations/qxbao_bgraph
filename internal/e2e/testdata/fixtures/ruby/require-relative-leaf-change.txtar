require_relative resolves against the file's directory: a change to the required file selects only its importers.
-- base/Gemfile --
source "https://rubygems.org"
gemspec
-- base/foo.gemspec --
Gem::Specification.new do |s|
  s.name = "foo"
  s.version = "1.0"
  s.summary = "Foo"
  s.files = Dir["lib/**/*.rb"]
  s.add_development_dependency "rspec"
end
-- base/lib/foo/a.rb --
A = 1
-- base/lib/foo/b.rb --
B = 1
-- base/spec/a_spec.rb --
require_relative "../lib/foo/a"
-- base/spec/b_spec.rb --
require_relative "../lib/foo/b"
-- head/lib/foo/a.rb --
A = 2
-- want --
notfull
scope graph
select spec/a_spec.rb
noselect spec/b_spec.rb
