A declaration never replaces an uncertain scan: the file keeps firing.
-- base/Gemfile --
source "https://rubygems.org"
gemspec
-- base/foo.gemspec --
Gem::Specification.new { |s| s.name = "foo" }
-- base/lib/foo/plugins.rb --
module Foo
  def self.load_plugin(name)
    require name
  end
  def self.load_other(path)
    load path
  end
end
-- base/lib/foo/plain.rb --
P = 1
-- base/plugins/a.rb --
A = 1
-- base/spec/plugins_spec.rb --
require "foo/plugins"
-- base/spec/plain_spec.rb --
require "foo/plain"
-- base/lib/foo/broken.rb --
X = <<~EOS
  never terminated
-- base/spec/broken_spec.rb --
require "foo/broken"
-- base/bgraph.toml --
[[dynamic]]
file = "lib/foo/broken.rb"
none = true
reason = "trying to silence"
-- head/lib/foo/plain.rb --
P = 2
-- want --
notfull
widen uncertain_scan
select spec/broken_spec.rb
select spec/plain_spec.rb
