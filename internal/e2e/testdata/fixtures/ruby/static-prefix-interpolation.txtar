require "foo/cops/#{name}": the importer depends on every Ruby file under foo/cops, including files added later.
-- base/Gemfile --
source "https://rubygems.org"
gemspec
-- base/foo.gemspec --
Gem::Specification.new do |s|
  s.name = "foo"
  s.version = "1.0"
  s.summary = "Foo"
  s.files = Dir["lib/**/*.rb"]
  s.add_development_dependency "rspec"
end
-- base/lib/foo/registry.rb --
module Foo
  def self.load_cop(name)
    require "foo/cops/#{name}"
  end
end
-- base/lib/foo/cops/a.rb --
A = 1
-- base/lib/foo/unrelated.rb --
U = 1
-- base/spec/registry_spec.rb --
require "foo/registry"
-- base/spec/unrelated_spec.rb --
require "foo/unrelated"
-- head/lib/foo/cops/new_cop.rb --
N = 1
-- want --
notfull
scope graph
nowiden dynamic_import
select spec/registry_spec.rb
noselect spec/unrelated_spec.rb
