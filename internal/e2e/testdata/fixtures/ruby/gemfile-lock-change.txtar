A Gemfile.lock change is lock_changed at level L0 at the lockfile's directory.
-- base/Gemfile --
source "https://rubygems.org"
gemspec
-- base/foo.gemspec --
Gem::Specification.new do |s|
  s.name = "foo"
  s.version = "1.0"
  s.summary = "Foo"
  s.files = Dir["lib/**/*.rb"]
  s.add_development_dependency "rspec"
end
-- base/Gemfile.lock --
GEM
  remote: https://rubygems.org/
  specs:
    rspec (3.12.0)
-- base/spec/a_spec.rb --
x = 1
-- base/other/Gemfile --
source "https://rubygems.org"
-- base/other/spec/b_spec.rb --
y = 1
-- base/web/package.json --
{"name":"web","devDependencies":{"vitest":"^1.0.0"}}
-- base/web/src/a.test.ts --
import { expect } from "vitest"
-- head/Gemfile.lock --
GEM
  remote: https://rubygems.org/
  specs:
    rspec (3.13.0)
-- want --
notfull
widen lock_changed
select spec/a_spec.rb
select other/spec/b_spec.rb
noselect web/src/a.test.ts
