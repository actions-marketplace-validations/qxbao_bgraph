A require of a computed name may load any Ruby file: a Ruby change anywhere selects the tests that reach the dynamic site.
-- base/Gemfile --
source "https://rubygems.org"
gemspec
-- base/foo.gemspec --
Gem::Specification.new do |s|
  s.name = "foo"
  s.version = "1.0"
  s.summary = "Foo"
  s.files = Dir["lib/**/*.rb"]
  s.add_development_dependency "rspec"
end
-- base/lib/foo/plugins.rb --
module Foo
  def self.load_plugin(name)
    require name
  end
end
-- base/lib/foo/leaf.rb --
L = 1
-- base/lib/foo/plain.rb --
P = 1
-- base/spec/plugins_spec.rb --
require "foo/plugins"
-- base/spec/leaf_spec.rb --
require "foo/leaf"
-- base/spec/plain_spec.rb --
require "foo/plain"
-- head/lib/foo/leaf.rb --
L = 2
-- want --
notfull
scope graph
nowiden unreferenced_file
select spec/leaf_spec.rb
widen dynamic_import
select spec/plugins_spec.rb
noselect spec/plain_spec.rb
