A Ruby file added anywhere seeds a dynamic require site.
-- base/Gemfile --
source "https://rubygems.org"
gemspec
-- base/foo.gemspec --
Gem::Specification.new do |s|
  s.name = "foo"
  s.version = "1.0"
  s.summary = "Foo"
  s.files = Dir["lib/**/*.rb"]
  s.add_development_dependency "rspec"
end
-- base/lib/foo/plugins.rb --
module Foo
  def self.load(name) = Kernel.require(name)
end
-- base/spec/plugins_spec.rb --
require "foo/plugins"
-- base/spec/plain_spec.rb --
x = 1
-- base/sub/sub.gemspec --
Gem::Specification.new { |s| s.name = "sub" }
-- base/sub/spec/sub_spec.rb --
y = 1
-- head/sub/lib/extra.rb --
X = 1
-- want --
notfull
widen dynamic_import
select spec/plugins_spec.rb
# the new file itself is unreferenced: its own project widens
select sub/spec/sub_spec.rb
noselect spec/plain_spec.rb
