In a mixed repository a change in the Node project selects no Ruby test.
-- base/Gemfile --
source "https://rubygems.org"
gemspec
-- base/foo.gemspec --
Gem::Specification.new do |s|
  s.name = "foo"
  s.version = "1.0"
  s.summary = "Foo"
  s.files = Dir["lib/**/*.rb"]
  s.add_development_dependency "rspec"
end
-- base/lib/foo.rb --
F = 1
-- base/spec/foo_spec.rb --
require "foo"
-- base/web/package.json --
{"name":"web","devDependencies":{"vitest":"^1.0.0"}}
-- base/web/src/a.ts --
export const a = 1
-- base/web/src/a.test.ts --
import { a } from './a'
-- base/web/config/settings.yml --
a: 1
-- head/web/src/a.ts --
export const a = 2
-- want --
notfull
select web/src/a.test.ts
noselect spec/foo_spec.rb
