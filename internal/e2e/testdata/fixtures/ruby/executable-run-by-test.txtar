A spec that runs exe/foo depends on the executable and on what the executable requires.
-- base/Gemfile --
source "https://rubygems.org"
gemspec
-- base/foo.gemspec --
Gem::Specification.new do |s|
  s.name = "foo"
  s.version = "1.0"
  s.summary = "Foo"
  s.files = Dir["lib/**/*.rb"]
  s.add_development_dependency "rspec"
end
-- base/exe/foo --
#!/usr/bin/env ruby
require_relative "../lib/foo/cli"
Foo::CLI.start(ARGV)
-- base/lib/foo/cli.rb --
module Foo; class CLI; def self.start(a); end; end; end
-- base/lib/foo/other.rb --
O = 1
-- base/spec/cli_spec.rb --
it "runs" do
  expect(system("exe/foo --version")).to be true
end
-- base/spec/other_spec.rb --
require "foo/other"
-- head/lib/foo/cli.rb --
module Foo; class CLI; def self.start(a); puts 1; end; end; end
-- want --
notfull
scope graph
select spec/cli_spec.rb
noselect spec/other_spec.rb
