A Gemfile change is a manifest change at its directory (scoped to Ruby tests).
-- base/Gemfile --
source "https://rubygems.org"
gemspec
-- base/foo.gemspec --
Gem::Specification.new do |s|
  s.name = "foo"
  s.version = "1.0"
  s.summary = "Foo"
  s.files = Dir["lib/**/*.rb"]
  s.add_development_dependency "rspec"
end
-- base/spec/a_spec.rb --
x = 1
-- base/web/package.json --
{"name":"web","devDependencies":{"vitest":"^1.0.0"}}
-- base/web/src/a.test.ts --
import { expect } from "vitest"
-- head/Gemfile --
source "https://rubygems.org"
gemspec
gem "pry"
-- want --
notfull
widen manifest_changed
select spec/a_spec.rb
noselect web/src/a.test.ts
