Zeitwerk::Loader.for_gem autoloads every file below the gem's root file directory, including files added later.
-- base/Gemfile --
source "https://rubygems.org"
gemspec
-- base/foo.gemspec --
Gem::Specification.new do |s|
  s.name = "foo"
  s.version = "1.0"
  s.summary = "Foo"
  s.files = Dir["lib/**/*.rb"]
  s.add_development_dependency "rspec"
end
-- base/lib/foo.rb --
require "zeitwerk"
loader = Zeitwerk::Loader.for_gem
loader.setup
-- base/lib/foo/bar.rb --
module Foo; class Bar; end; end
-- base/spec/foo_spec.rb --
require "foo"
-- base/spec/plain_spec.rb --
x = 1
-- head/lib/foo/new_thing.rb --
module Foo; class NewThing; end; end
-- want --
notfull
select spec/foo_spec.rb
noselect spec/plain_spec.rb
