A test file change selects that test only.
-- base/Gemfile --
source "https://rubygems.org"
gemspec
-- base/foo.gemspec --
Gem::Specification.new do |s|
  s.name = "foo"
  s.version = "1.0"
  s.summary = "Foo"
  s.files = Dir["lib/**/*.rb"]
  s.add_development_dependency "rspec"
end
-- base/spec/a_spec.rb --
x = 1
-- base/spec/b_spec.rb --
y = 1
-- head/spec/a_spec.rb --
x = 2
-- want --
notfull
scope graph
select spec/a_spec.rb
noselect spec/b_spec.rb
