A dynamic require only loads Ruby files: a YAML data change that a spec names does not seed the dynamic site.
-- base/Gemfile --
source "https://rubygems.org"
gemspec
-- base/foo.gemspec --
Gem::Specification.new do |s|
  s.name = "foo"
  s.version = "1.0"
  s.summary = "Foo"
  s.files = Dir["lib/**/*.rb"]
  s.add_development_dependency "rspec"
end
-- base/lib/foo/plugins.rb --
module Foo
  def self.load(name) = Kernel.require(name)
end
-- base/spec/plugins_spec.rb --
require "foo/plugins"
-- base/spec/config_spec.rb --
CFG = File.read(File.join(__dir__, "data", "x.yml"))
-- base/spec/data/x.yml --
a: 1
-- head/spec/data/x.yml --
a: 2
-- want --
notfull
nowiden dynamic_import
select spec/config_spec.rb
noselect spec/plugins_spec.rb
