p.join('test', 'data', name) keeps its literal head: test/data/* is a dependency.
-- base/pubspec.yaml --
name: app
environment:
  sdk: ^3.5.0
dependencies:
  path: any
dev_dependencies:
  test: ^1.25.0
-- base/test/data_test.dart --
import 'package:test/test.dart';
import 'dart:io';
import 'package:path/path.dart' as p;
void main() => test('d', () => File(p.join('test', 'data', name)).readAsStringSync());
final name = ['x', 'txt'].join('.');
-- base/test/data/x.txt --
1
-- base/test/logic_test.dart --
import 'package:test/test.dart';
void main() => test('l', () {});
-- head/test/data/x.txt --
2
-- want --
scope graph
select test/data_test.dart
noselect test/logic_test.dart
