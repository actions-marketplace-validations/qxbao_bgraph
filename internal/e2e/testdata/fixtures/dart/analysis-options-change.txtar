analysis_options.yaml is read by the analyzer only: no widening (the lib change selects its test).
-- base/pubspec.yaml --
name: app
environment:
  sdk: ^3.5.0
dev_dependencies:
  test: ^1.25.0
-- base/analysis_options.yaml --
include: package:lints/recommended.yaml
-- base/lib/a.dart --
int a() => 1;
-- base/lib/b.dart --
int b() => 1;
-- base/test/a_test.dart --
import 'package:test/test.dart';
import 'package:app/a.dart';
void main() => test('a', () => a());
-- base/test/b_test.dart --
import 'package:test/test.dart';
import 'package:app/b.dart';
void main() => test('b', () => b());
-- head/analysis_options.yaml --
include: package:lints/recommended.yaml
linter:
  rules: [prefer_const_constructors]
-- head/lib/a.dart --
int a() => 2;
-- want --
scope graph
nowiden test_config_changed
nowiden unknown_file
select test/a_test.dart
noselect test/b_test.dart
