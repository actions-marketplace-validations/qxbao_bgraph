The flutter: section (assets) is not harmless: the package is widened.
-- base/pubspec.yaml --
name: app
environment:
  sdk: ^3.5.0
dependencies:
  flutter:
    sdk: flutter
flutter:
  assets:
    - assets/a.json
dev_dependencies:
  flutter_test:
    sdk: flutter
  integration_test:
    sdk: flutter
-- base/test/a_test.dart --
import 'package:flutter_test/flutter_test.dart';
void main() => test('a', () {});
-- base/other/pubspec.yaml --
name: other
environment:
  sdk: ^3.5.0
dependencies:
  flutter:
    sdk: flutter
dev_dependencies:
  flutter_test:
    sdk: flutter
  integration_test:
    sdk: flutter
-- base/other/test/o_test.dart --
import 'package:flutter_test/flutter_test.dart';
void main() => test('o', () {});
-- head/pubspec.yaml --
name: app
environment:
  sdk: ^3.5.0
dependencies:
  flutter:
    sdk: flutter
flutter:
  assets:
    - assets/a.json
    - assets/b.json
dev_dependencies:
  flutter_test:
    sdk: flutter
  integration_test:
    sdk: flutter
-- want --
scope module
widen manifest_changed
select test/a_test.dart
noselect other/test/o_test.dart
