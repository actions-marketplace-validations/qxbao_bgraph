Top-level paths and filename of dart_test.yaml are honoured: spec/*_spec.dart files are units.
-- base/pubspec.yaml --
name: app
environment:
  sdk: ^3.5.0
dev_dependencies:
  test: ^1.25.0
-- base/dart_test.yaml --
paths: [spec]
filename: "*_spec.dart"
-- base/lib/a.dart --
int a() => 1;
-- base/lib/b.dart --
int b() => 1;
-- base/spec/a_spec.dart --
import 'package:test/test.dart';
import 'package:app/a.dart';
void main() => test('a', () => a());
-- base/spec/b_spec.dart --
import 'package:test/test.dart';
import 'package:app/b.dart';
void main() => test('b', () => b());
-- head/lib/a.dart --
int a() => 2;
-- want --
scope graph
select spec/a_spec.dart
noselect spec/b_spec.dart
