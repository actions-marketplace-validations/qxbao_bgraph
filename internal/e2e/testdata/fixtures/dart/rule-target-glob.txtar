A glob target over Dart test files selects the matching units.
-- base/a/pubspec.yaml --
name: a
environment:
  sdk: ^3.5.0
dev_dependencies:
  test: ^1.25.0
-- base/a/test/x_test.dart --
import 'package:test/test.dart';
void main() => test('x', () {});
-- base/a/test/y_test.dart --
import 'package:test/test.dart';
void main() => test('y', () {});
-- base/proto/api.proto --
syntax = "proto3";
-- base/bgraph.toml --
[[rule]]
paths = ["proto/**"]
affects = ["a/test/x_*.dart"]
-- head/proto/api.proto --
syntax = "proto3"; // v2
-- want --
select a/test/x_test.dart
noselect a/test/y_test.dart
notfull
