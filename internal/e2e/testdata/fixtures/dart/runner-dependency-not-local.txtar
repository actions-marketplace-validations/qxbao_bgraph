A package named like nothing the test runner loads: a change to it selects only the tests that import it.
-- base/pubspec.yaml --
name: ws
environment:
  sdk: ^3.6.0
workspace:
  - pkgs/money
  - pkgs/fixnum
-- base/pkgs/money/pubspec.yaml --
name: money
environment:
  sdk: ^3.6.0
resolution: workspace
-- base/pkgs/money/lib/money.dart --
int cents() => 1;
-- base/pkgs/money/test/money_test.dart --
import 'package:test/test.dart';
import 'package:money/money.dart';
void main() => test('m', () => cents());
-- base/pkgs/fixnum/pubspec.yaml --
name: fixnum
environment:
  sdk: ^3.6.0
resolution: workspace
-- base/pkgs/fixnum/test/fixnum_test.dart --
import 'package:test/test.dart';
void main() => test('f', () {});
-- head/pkgs/money/lib/money.dart --
int cents() => 2;
-- want --
scope graph
select pkgs/money/test/money_test.dart
noselect pkgs/fixnum/test/fixnum_test.dart
