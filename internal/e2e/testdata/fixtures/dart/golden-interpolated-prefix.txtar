An interpolated golden path keeps its static directory prefix: goldens/$name.png depends on goldens/*.png.
-- base/pubspec.yaml --
name: app
environment:
  sdk: ^3.5.0
dependencies:
  flutter:
    sdk: flutter
dev_dependencies:
  flutter_test:
    sdk: flutter
  integration_test:
    sdk: flutter
-- base/test/screens_test.dart --
import 'package:flutter_test/flutter_test.dart';
void main() {
  for (final name in ['home', 'settings']) {
    testWidgets(name, (t) async {
      await expectLater(find.byType(Object), matchesGoldenFile('goldens/$name.png'));
    });
  }
}
-- base/test/goldens/home.png --
png-1
-- base/test/goldens/settings.png --
png-1
-- base/test/logic_test.dart --
import 'package:flutter_test/flutter_test.dart';
void main() => test('l', () {});
-- head/test/goldens/settings.png --
png-2
-- want --
scope graph
select test/screens_test.dart
noselect test/logic_test.dart
