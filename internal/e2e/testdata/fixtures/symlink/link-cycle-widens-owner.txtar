A directory symlink that re-enters itself (apps/a/loop -> ..) is a cycle: it is followed one level, and a change under
its target widens with symlink_outside to the owning project.
-- base/apps/a/package.json --
{"name":"a","devDependencies":{"vitest":"^5.0.0"}}
-- base/apps/a/src/a.test.ts --
import { test } from 'vitest'
test('a', () => {})
-- base/apps/b/package.json --
{"name":"b","devDependencies":{"vitest":"^5.0.0"}}
-- base/apps/b/src/b.test.ts --
import { test } from 'vitest'
test('b', () => {})
-- link:base/apps/a/loop --
..
-- base/apps/a/src/x.ts --
export const x = 1
-- base/apps/a/src/x.test.ts --
import { x } from '../loop/a/src/x'
-- head/apps/a/src/x.ts --
export const x = 2
-- want --
widen symlink_outside
scope module
select apps/a/src/x.test.ts
noselect apps/b/src/b.test.ts
