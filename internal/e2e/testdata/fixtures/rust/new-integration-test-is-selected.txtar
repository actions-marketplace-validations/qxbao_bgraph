A newly added integration test is a new unit and is selected.
-- base/Cargo.toml --
[package]
name = "p"
version = "0.1.0"
edition = "2021"
-- base/src/lib.rs --
pub fn f() {}
-- base/tests/a.rs --
#[test]
fn t() {}
-- head/tests/new.rs --
#[test]
fn t() {}
-- want --
notfull
select .::test:new
noselect .::test:a
noselect .::lib
