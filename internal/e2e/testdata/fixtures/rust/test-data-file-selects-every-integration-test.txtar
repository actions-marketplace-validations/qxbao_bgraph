Unowned data under tests/ is package-level: integration tests read it, and unit tests in src/ may read it at runtime too
(std::fs::read("tests/data/...")), so every target of the package is selected.
-- base/Cargo.toml --
[package]
name = "p"
version = "0.1.0"
edition = "2021"
-- base/src/lib.rs --
pub fn f() {}
-- base/tests/a.rs --
#[test]
fn t() {}
-- base/tests/b.rs --
#[test]
fn t() {}
-- base/tests/data/x.json --
{}
-- head/tests/data/x.json --
{"a": 1}
-- want --
notfull
select .::test:a
select .::test:b
select .::lib
