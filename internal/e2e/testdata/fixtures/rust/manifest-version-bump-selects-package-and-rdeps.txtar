package.version feeds CARGO_PKG_VERSION: a bump affects the package and its dependents.
-- base/Cargo.toml --
[workspace]
members = ["crates/*"]
resolver = "2"
-- base/crates/a/Cargo.toml --
[package]
name = "a"
version = "0.1.0"
edition = "2021"
-- base/crates/a/src/lib.rs --
pub fn f() {}
-- base/crates/b/Cargo.toml --
[package]
name = "b"
version = "0.1.0"
edition = "2021"
-- base/crates/b/src/lib.rs --
pub fn f() {}
-- base/crates/c/Cargo.toml --
[package]
name = "c"
version = "0.1.0"
edition = "2021"

[dependencies]
a = { path = "../a" }
-- base/crates/c/src/lib.rs --
pub fn f() {}
-- head/crates/a/Cargo.toml --
[package]
name = "a"
version = "0.2.0"
edition = "2021"
-- want --
notfull
select crates/a::lib
select crates/c::lib
noselect crates/b::lib
