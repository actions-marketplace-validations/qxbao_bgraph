A directory named by a literal in build.rs: every file under it is an input.
-- base/Cargo.toml --
[workspace]
members = ["crates/*"]
resolver = "2"
-- base/crates/gen/Cargo.toml --
[package]
name = "gen"
version = "0.1.0"
edition = "2021"
-- base/crates/gen/build.rs --
fn main() {
    let _ = std::fs::read_dir("proto");
}
-- base/crates/gen/proto/a.proto --
message A {}
-- base/crates/gen/src/lib.rs --
pub fn f() {}
-- base/crates/gen/tests/t.rs --
#[test]
fn t() {}
-- base/crates/unrelated/Cargo.toml --
[package]
name = "unrelated"
version = "0.1.0"
edition = "2021"
-- base/crates/unrelated/src/lib.rs --
pub fn f() {}
-- base/crates/user/Cargo.toml --
[package]
name = "user"
version = "0.1.0"
edition = "2021"

[dependencies]
gen = { path = "../gen" }
-- base/crates/user/src/lib.rs --
pub fn f() {}
-- head/crates/gen/proto/a.proto --
message A { int32 x = 1; }
-- want --
notfull
select crates/gen::lib
select crates/user::lib
noselect crates/unrelated::lib
