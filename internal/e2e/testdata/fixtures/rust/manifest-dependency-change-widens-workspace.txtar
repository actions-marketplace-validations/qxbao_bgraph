A dependency change in one member re-unifies features for the whole workspace.
-- base/Cargo.toml --
[workspace]
members = ["crates/*"]
resolver = "2"
-- base/crates/a/Cargo.toml --
[package]
name = "a"
version = "0.1.0"
edition = "2021"
-- base/crates/a/src/lib.rs --
pub fn f() {}
-- base/crates/b/Cargo.toml --
[package]
name = "b"
version = "0.1.0"
edition = "2021"
-- base/crates/b/src/lib.rs --
pub fn f() {}
-- head/crates/a/Cargo.toml --
[package]
name = "a"
version = "0.1.0"
edition = "2021"

[dependencies]
serde = "1"
-- want --
notfull
widen manifest_changed
scope module
select crates/a::lib
select crates/b::lib
