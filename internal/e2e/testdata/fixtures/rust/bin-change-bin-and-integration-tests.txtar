A bin change selects the bin unit and every integration test (cargo builds the bin for them), not the lib unit or the doc-tests.
-- base/Cargo.toml --
[package]
name = "p"
version = "0.1.0"
edition = "2021"
-- base/src/cli.rs --
pub fn run() {}
-- base/src/lib.rs --
pub fn f() {}
-- base/src/main.rs --
mod cli;
fn main() {}
-- base/tests/a.rs --
#[test]
fn t() {}
-- base/tests/b.rs --
#[test]
fn t() {}
-- head/src/cli.rs --
pub fn run() { /* changed */ }
-- want --
notfull
select .::bin:p
select .::test:a
select .::test:b
noselect .::lib
noselect .::doc
