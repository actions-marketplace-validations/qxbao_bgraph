A data file included by one integration test only selects that test.
-- base/Cargo.toml --
[package]
name = "p"
version = "0.1.0"
edition = "2021"
-- base/data/only_a.txt --
one
-- base/src/lib.rs --
pub fn f() {}
-- base/tests/a.rs --
const D: &str = include_str!("../data/only_a.txt");
#[test]
fn t() {}
-- base/tests/b.rs --
#[test]
fn t() {}
-- head/data/only_a.txt --
two
-- want --
notfull
select .::test:a
noselect .::test:b
noselect .::lib
noselect .::doc
