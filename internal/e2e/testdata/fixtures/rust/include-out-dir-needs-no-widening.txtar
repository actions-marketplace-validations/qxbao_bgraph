include!(concat!(env!("OUT_DIR"), ...)) is build output, covered by the build script: no whole-package dependency.
-- base/Cargo.toml --
[package]
name = "p"
version = "0.1.0"
edition = "2021"
-- base/build.rs --
fn main() {}
-- base/src/lib.rs --
include!(concat!(env!("OUT_DIR"), "/gen.rs"));
-- base/src/main.rs --
fn main() {}
-- base/tests/a.rs --
#[test]
fn t() {}
-- base/tests/b.rs --
#[test]
fn t() {}
-- base/tests/data/x.txt --
x
-- head/tests/a.rs --
#[test]
fn t() {}
// changed
-- want --
notfull
select .::test:a
noselect .::test:b
noselect .::lib
