A file outside the package that build.rs names by a literal path is an input of the package and of its dependents.
-- base/Cargo.toml --
[workspace]
members = ["crates/*"]
resolver = "2"
-- base/crates/gen/Cargo.toml --
[package]
name = "gen"
version = "0.1.0"
edition = "2021"
-- base/crates/gen/build.rs --
fn main() {
    println!("cargo:rerun-if-changed=../shared/x.txt");
    let _ = std::fs::read_to_string("../shared/x.txt");
}
-- base/crates/gen/src/lib.rs --
pub fn f() {}
-- base/crates/gen/tests/t.rs --
#[test]
fn t() {}
-- base/crates/shared/x.txt --
one
-- base/crates/unrelated/Cargo.toml --
[package]
name = "unrelated"
version = "0.1.0"
edition = "2021"
-- base/crates/unrelated/src/lib.rs --
pub fn f() {}
-- base/crates/user/Cargo.toml --
[package]
name = "user"
version = "0.1.0"
edition = "2021"

[dependencies]
gen = { path = "../gen" }
-- base/crates/user/src/lib.rs --
pub fn f() {}
-- head/crates/shared/x.txt --
two
-- want --
notfull
select crates/gen::lib
select crates/gen::test:t
select crates/user::lib
noselect crates/unrelated::lib
