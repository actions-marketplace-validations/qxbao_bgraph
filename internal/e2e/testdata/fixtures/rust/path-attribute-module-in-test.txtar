A #[path] module of one integration test (a shared file inside the package) selects only that test.
-- base/Cargo.toml --
[package]
name = "p"
version = "0.1.0"
edition = "2021"
-- base/shared/h.rs --
pub fn h() {}
-- base/src/lib.rs --
pub fn f() {}
-- base/tests/a.rs --
#[path = "../shared/h.rs"]
mod h;
#[test]
fn t() {}
-- base/tests/b.rs --
#[test]
fn t() {}
-- head/shared/h.rs --
pub fn h() { /* changed */ }
-- want --
notfull
select .::test:a
noselect .::test:b
noselect .::lib
