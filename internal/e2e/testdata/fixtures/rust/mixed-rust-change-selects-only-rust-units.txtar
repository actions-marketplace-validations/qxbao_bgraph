In a Node+Rust repo a Rust change selects Rust units only.
-- base/Cargo.lock --
version = 4
-- base/Cargo.toml --
[workspace]
members = ["crates/*"]
resolver = "2"
-- base/crates/lib/Cargo.toml --
[package]
name = "lib"
version = "0.1.0"
edition = "2021"
-- base/crates/lib/src/lib.rs --
pub fn f() {}
-- base/crates/lib/tests/t.rs --
#[test]
fn t() {}
-- base/web/package.json --
{"name":"web","devDependencies":{"vitest":"^2.0.0"}}
-- base/web/src/a.test.ts --
import { a } from './a'
void a
-- base/web/src/a.ts --
export const a = 1
-- head/crates/lib/src/lib.rs --
pub fn f() { /* changed */ }
-- want --
notfull
select crates/lib::lib
select crates/lib::test:t
noselect web/src/a.test.ts
