The SDK default globs make a file belong to every ancestor project: a change below a nested project selects both; an unrelated project stays out.
-- base/src/Outer/Outer.csproj --
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net8.0</TargetFramework></PropertyGroup>
</Project>
-- base/src/Outer/Y.cs --
class Y {}
-- base/src/Outer/Inner/Inner.csproj --
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net8.0</TargetFramework></PropertyGroup>
</Project>
-- base/src/Outer/Inner/X.cs --
class X {}
-- base/src/Sibling/Sibling.csproj --
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net8.0</TargetFramework></PropertyGroup>
</Project>
-- base/src/Sibling/S.cs --
class S {}
-- head/src/Outer/Inner/X.cs --
class X { int a; }
-- want --
notfull
select dotnet:src/Outer/Inner/Inner.csproj
select dotnet:src/Outer/Outer.csproj
noselect dotnet:src/Sibling/Sibling.csproj
