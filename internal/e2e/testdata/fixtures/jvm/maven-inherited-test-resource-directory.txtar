A <testResource> directory declared in a parent POM is resolved against each child: a child that reads another module's src/test/resources through it is selected when a file there changes.
-- base/pom.xml --
<project>
<modelVersion>4.0.0</modelVersion>
<groupId>org.ex</groupId>
<artifactId>root</artifactId>
<version>1.0</version>
<packaging>pom</packaging>
<modules><module>common</module><module>app</module></modules>
<build><testResources><testResource><directory>${project.basedir}/../common/src/test/resources</directory></testResource></testResources></build>
</project>
-- base/common/pom.xml --
<project>
<modelVersion>4.0.0</modelVersion>
<parent><groupId>org.ex</groupId><artifactId>root</artifactId><version>1.0</version></parent>
<artifactId>common</artifactId>
</project>
-- base/common/src/test/resources/data.json --
{}
-- base/app/pom.xml --
<project>
<modelVersion>4.0.0</modelVersion>
<parent><groupId>org.ex</groupId><artifactId>root</artifactId><version>1.0</version></parent>
<artifactId>app</artifactId>
</project>
-- base/app/src/test/java/AppTest.java --
class AppTest {}
-- head/common/src/test/resources/data.json --
{"a":1}
-- want --
notfull
select maven:common
select maven:app
noselect maven:.
