An annotation processor that is a reactor module referenced only through maven-compiler-plugin <annotationProcessorPaths> (not a <dependency>): a change in the processor selects the module it processes.
-- base/pom.xml --
<project>
<modelVersion>4.0.0</modelVersion>
<groupId>org.ex</groupId>
<artifactId>root</artifactId>
<version>1.0</version>
<packaging>pom</packaging>
<modules><module>proc</module><module>app</module><module>other</module></modules>
</project>
-- base/proc/pom.xml --
<project>
<modelVersion>4.0.0</modelVersion>
<parent><groupId>org.ex</groupId><artifactId>root</artifactId><version>1.0</version></parent>
<artifactId>proc</artifactId>
</project>
-- base/proc/src/main/java/P.java --
class P {}
-- base/app/pom.xml --
<project>
<modelVersion>4.0.0</modelVersion>
<parent><groupId>org.ex</groupId><artifactId>root</artifactId><version>1.0</version></parent>
<artifactId>app</artifactId>
<build><plugins><plugin>
<artifactId>maven-compiler-plugin</artifactId>
<configuration><annotationProcessorPaths><path><groupId>${project.groupId}</groupId><artifactId>proc</artifactId><version>${project.version}</version></path></annotationProcessorPaths></configuration>
</plugin></plugins></build>
</project>
-- base/app/src/test/java/AppTest.java --
class AppTest {}
-- base/other/pom.xml --
<project>
<modelVersion>4.0.0</modelVersion>
<parent><groupId>org.ex</groupId><artifactId>root</artifactId><version>1.0</version></parent>
<artifactId>other</artifactId>
</project>
-- head/proc/src/main/java/P.java --
class P { int x; }
-- want --
notfull
select maven:proc
select maven:app
noselect maven:other
