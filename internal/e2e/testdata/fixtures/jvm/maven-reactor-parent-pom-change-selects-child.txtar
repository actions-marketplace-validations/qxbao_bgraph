A change to a parent POM that a child reaches by coordinates through the reactor (its relativePath points elsewhere) selects the child.
-- base/pom.xml --
<project>
<modelVersion>4.0.0</modelVersion>
<groupId>org.ex</groupId>
<artifactId>root</artifactId>
<version>1.0</version>
<packaging>pom</packaging>
<modules><module>parent</module><module>app</module><module>other</module></modules>
</project>
-- base/parent/pom.xml --
<project>
<modelVersion>4.0.0</modelVersion>
<groupId>org.ex</groupId>
<artifactId>java-parent</artifactId>
<version>1.0</version>
<packaging>pom</packaging>
<properties><java.version>17</java.version></properties>
</project>
-- base/app/pom.xml --
<project>
<modelVersion>4.0.0</modelVersion>
<parent><groupId>org.ex</groupId><artifactId>java-parent</artifactId><version>1.0</version><relativePath/></parent>
<artifactId>app</artifactId>
</project>
-- base/app/src/test/java/AppTest.java --
class AppTest {}
-- base/other/pom.xml --
<project>
<modelVersion>4.0.0</modelVersion>
<parent><groupId>org.ex</groupId><artifactId>root</artifactId><version>1.0</version></parent>
<artifactId>other</artifactId>
</project>
-- head/parent/pom.xml --
<project>
<modelVersion>4.0.0</modelVersion>
<groupId>org.ex</groupId>
<artifactId>java-parent</artifactId>
<version>1.0</version>
<packaging>pom</packaging>
<properties><java.version>21</java.version></properties>
</project>
-- want --
notfull
select maven:parent
select maven:app
noselect maven:other
