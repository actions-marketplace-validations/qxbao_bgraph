The applied script plugin sits in the root's gradle/ directory: a change to it reaches the projects (shared file of the enclosing project).
-- base/app/build.gradle --
plugins { id 'java' }

-- base/app/src/main/java/app.java --
class app {}
-- base/core/build.gradle --
plugins { id 'java' }

-- base/core/src/main/java/core.java --
class core {}
-- base/gradle/common.gradle --
// common
-- base/settings.gradle --
include ':core', ':app'
-- head/gradle/common.gradle --
// common v2
-- want --
notfull
select gradle::core
select gradle::app
