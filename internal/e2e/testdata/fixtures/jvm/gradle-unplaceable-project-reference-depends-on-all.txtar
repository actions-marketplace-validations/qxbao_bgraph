project(":$name") cannot be placed: the project depends on every project of the build (no full).
-- base/app/build.gradle --
plugins { id 'java' }
dependencies {
  [':core'].each { n -> implementation project(":$n") }
}

-- base/app/src/main/java/app.java --
class app {}
-- base/core/build.gradle --
plugins { id 'java' }

-- base/core/src/main/java/core.java --
class core {}
-- base/other/build.gradle --
plugins { id 'java' }

-- base/other/src/main/java/other.java --
class other {}
-- base/settings.gradle --
include ':core', ':app', ':other'
-- head/other/src/main/java/other.java --
class other { int a;}
-- want --
notfull
select gradle::other
select gradle::app
noselect gradle::core
