A file of no known kind (sql under the module root) belongs to the module: selected without an unknown_file widening.
-- base/core/db/schema.sql --
create table a (x int);
-- base/core/pom.xml --
<project>
<modelVersion>4.0.0</modelVersion>
<parent><groupId>org.ex</groupId><artifactId>root</artifactId><version>1.0</version></parent>
<artifactId>core</artifactId>




</project>
-- base/other/pom.xml --
<project>
<modelVersion>4.0.0</modelVersion>
<parent><groupId>org.ex</groupId><artifactId>root</artifactId><version>1.0</version></parent>
<artifactId>other</artifactId>




</project>
-- base/pom.xml --
<project>
<modelVersion>4.0.0</modelVersion>
<groupId>org.ex</groupId>
<artifactId>root</artifactId>
<version>1.0</version>
<packaging>pom</packaging>
<modules><module>core</module><module>other</module></modules>

</project>
-- head/core/db/schema.sql --
create table a (x bigint);
-- want --
notfull
nowiden unknown_file
nowiden unreferenced_file
select maven:core
noselect maven:other
