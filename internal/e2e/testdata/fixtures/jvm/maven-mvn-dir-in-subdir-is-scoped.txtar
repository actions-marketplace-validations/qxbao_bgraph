A .mvn change below the repo root widens to that reactor's JVM units only.
-- base/backend/.mvn/jvm.config --
-Xmx1g
-- base/backend/core/pom.xml --
<project>
<modelVersion>4.0.0</modelVersion>
<parent><groupId>org.ex</groupId><artifactId>root</artifactId><version>1.0</version></parent>
<artifactId>core</artifactId>




</project>
-- base/backend/pom.xml --
<project>
<modelVersion>4.0.0</modelVersion>
<groupId>org.ex</groupId>
<artifactId>root</artifactId>
<version>1.0</version>
<packaging>pom</packaging>
<modules><module>core</module></modules>

</project>
-- base/web/package.json --
{"name":"web","devDependencies":{"vitest":"^2.0.0"}}
-- base/web/src/a.test.ts --
import { a } from './a'
void a
-- base/web/src/a.ts --
export const a = 1
-- head/backend/.mvn/jvm.config --
-Xmx2g
-- want --
notfull
widen global_input
select maven:backend/core
noselect web/src/a.test.ts
