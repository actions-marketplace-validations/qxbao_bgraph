A nested project's files belong to the nested project, not to its parent; the parent's sources do not reach it.
-- base/a/b/build.gradle --
plugins { id 'java' }

-- base/a/b/src/main/java/B.java --
class B {}
-- base/a/build.gradle --
plugins { id 'java' }
-- base/a/src/main/java/A.java --
class A {}
-- base/settings.gradle --
include ':a:b'
-- head/a/b/src/main/java/B.java --
class B { int a;}
-- want --
notfull
select gradle::a:b
noselect gradle::a
