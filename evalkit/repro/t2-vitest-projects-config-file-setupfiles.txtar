Found by T2 (zod@2a343ed, mutant in packages/zod/src/compile.ts: zod-05, zod-15). The root vitest config lists one project as its own config FILE
(`projects: ["./vitest.compile.config.ts"]`); that file sets setupFiles = scripts/enable-compile.ts, and this setup imports src/compile.ts (a global side effect).
The setup runs before EVERY test file of the project, so changing compile.ts must select the project's test files (at least the tests that observe the effect, here stats.test.ts).
Actual: scope none, nothing selected. On the same tree, with setupFiles set directly in the root vitest.config.ts, it is CORRECT (verified): the bug is that the config of a
project declared by a file path in `projects` is not read (in zod: vitest.compile.config.ts).
To try: copy into internal/e2e/testdata/fixtures/node/ then `go test ./internal/e2e -run Fixtures`.
-- base/package.json --
{"name":"root","private":true,"devDependencies":{"vitest":"^4.0.0"}}
-- base/vitest.config.ts --
import { defineConfig } from "vitest/config";
export default defineConfig({ test: { projects: ["packages/*", "./vitest.compile.config.ts"] } });
-- base/vitest.compile.config.ts --
import { resolve } from "node:path";
import { defineConfig } from "vitest/config";
export default defineConfig({
  test: {
    include: ["packages/zod/src/**/*.test.ts"],
    setupFiles: [resolve(__dirname, "scripts/enable-compile.ts")],
  },
});
-- base/scripts/enable-compile.ts --
import "../packages/zod/src/compile";
-- base/packages/zod/package.json --
{"name":"zod","exports":{"./compile":{"@zod/source":"./src/compile.ts","types":"./compile.d.cts","import":"./compile.js"}}}
-- base/packages/zod/src/compile.ts --
(globalThis as any).__compiled = true;
-- base/packages/zod/src/stats.test.ts --
import { test, expect } from "vitest";
test("compile mode wired", () => { expect((globalThis as any).__compiled).toBeDefined(); });
-- base/packages/zod/src/other.test.ts --
import { test } from "vitest";
test("x", () => {});
-- head/packages/zod/src/compile.ts --
(globalThis as any).__compiled = false;
-- want --
select packages/zod/src/stats.test.ts
